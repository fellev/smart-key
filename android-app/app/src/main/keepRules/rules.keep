# R8 rules for SmartKey. Manifest components (service, receivers, activity) are
# kept automatically, and Tink / security-crypto / ViewBinding ship or need no
# blanket keep rules, so leaving them out lets R8 obfuscate as much as possible.

# Optional Tink dependencies that are not on the classpath.
-dontwarn com.google.api.client.**
-dontwarn javax.annotation.**
-dontwarn org.joda.time.**
-dontwarn kotlinx.coroutines.**

# Keep readable stack traces for crash reports and Play Console deobfuscation.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
